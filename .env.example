# Copy to .env (ignored by Git) and configure the existing MediaMTX instance.
# Compose starts only the panel. These URLs must be reachable from its container.
MTXUI_MEDIAMTX_URL=http://host.docker.internal:9997
MTXUI_METRICS_URL=http://host.docker.internal:9998/metrics
MTXUI_MEDIAMTX_USERNAME=panel
MTXUI_METRICS_USERNAME=panel
# Use the existing upstream account's password for API and Metrics.
MTX_API_PASSWORD=REPLACE_WITH_RANDOM_API_SECRET
# Set the initial panel administrator password (at least 12 bytes).
MTXUI_BOOTSTRAP_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
